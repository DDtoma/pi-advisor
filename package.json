{
  "name": "pi-advisor",
  "version": "0.1.0",
  "description": "Watchdog advisor extensions for pi — isolated LLM reviewers that audit the primary agent in the background",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.84.1 <1.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types test/run.ts",
    "lint:tokens": "node scripts/check-token-budget.mjs",
    "docs:check": "node scripts/check-docs-freshness.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "keywords": ["pi", "extension", "advisor", "watchdog", "llm", "review"],
  "repository": {
    "type": "git",
    "url": "https://github.com/DDtoma/pi-advisor.git"
  }
}
